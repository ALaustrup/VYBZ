# VYBZ environment variables
# Copy to `.env.local` (or run `vercel env pull .env.local` after linking the project).
# Never commit `.env.local` — it is git-ignored.

# ── Supabase (required for multi-user mode) ─────────────────────────────────
# Project: vyb-audio (ref xixmneooyufbeftdfpcm, us-west-1)
# Dashboard: https://supabase.com/dashboard/project/xixmneooyufbeftdfpcm
VITE_SUPABASE_URL=https://xixmneooyufbeftdfpcm.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Canonical app URL (auth redirects, email links, passkeys) ───────────────
# Production domain per VYBZ_MASTERPLAN.md — configure in Supabase Auth + Resend.
# Until DNS is live, previews may use https://vyb-audio.vercel.app
# VITE_APP_URL=https://vybz.astramatrix.xyz

# ── Stripe (Phase 12+ — new VYBZ products; do NOT reuse MYVYB links) ────────
# When unset, Godmode uses a clearly-labeled demo unlock.
# VITE_STRIPE_PAYMENT_LINK=

# ── Setup scripts only (never prefix with VITE_; never commit) ───────────────
# SUPABASE_ACCESS_TOKEN=sbp_...        # https://supabase.com/dashboard/account/tokens (email config + secrets)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...     # legacy JWT secret (Edge Functions)
# SUPABASE_SECRET_KEY=sb_secret_...    # new secret key (server-side only; apikey header, not Bearer)
# SUPABASE_PROJECT_REF=xixmneooyufbeftdfpcm
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_...                       # Resend API key (astramatrix.xyz verified)
# SMTP_SENDER_EMAIL=noreply@astramatrix.xyz
# SMTP_SENDER_NAME=VYBZ
# APP_URL=https://vybz.astramatrix.xyz
