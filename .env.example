# VYBZ environment variables
# Copy to `.env.local` (or run `vercel env pull .env.local` after linking the project).
# Never commit `.env.local` — it is git-ignored.

# ── Supabase (required for multi-user mode) ─────────────────────────────────
# Supabase project ref xixmneooyufbeftdfpcm (us-west-1)
# Dashboard: https://supabase.com/dashboard/project/xixmneooyufbeftdfpcm
# Vercel project: astramatrix/vybz (GitHub: ALaustrup/vyb-audio → main)
VITE_SUPABASE_URL=https://xixmneooyufbeftdfpcm.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Canonical app URL (auth redirects, email links, passkeys) ───────────────
# Production canon: https://vybz.cloud — configure in Supabase Auth + Resend.
# Preview alias: https://vybz.vercel.app
# VITE_APP_URL=https://vybz.cloud

# ── Stripe (Lane A — tips / credit top-ups; optional) ───────────────────────
# VITE_STRIPE_PAYMENT_LINK=

# ── Setup scripts only (never prefix with VITE_; never commit) ───────────────
# SUPABASE_ACCESS_TOKEN=sbp_...        # https://supabase.com/dashboard/account/tokens
# SUPABASE_SERVICE_ROLE_KEY=eyJ...     # Edge Functions
# SUPABASE_SECRET_KEY=sb_secret_...    # server-side only
# SUPABASE_PROJECT_REF=xixmneooyufbeftdfpcm
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_...
# SMTP_SENDER_EMAIL=noreply@astramatrix.xyz
# SMTP_SENDER_NAME=VYBZ
# APP_URL=https://vybz.cloud
