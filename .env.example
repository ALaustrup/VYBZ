# Veiled environment variables
# Copy to `.env.local` and fill in to enable real Stripe checkout.

# Stripe Payment Link for the one-time "Veiled Plus / Godmode" purchase ($3.69).
# Create it in the Stripe Dashboard (Products → Payment Links). Set the link's
# post-payment redirect to your deployed app with the success flag, e.g.:
#   https://getveiled.vercel.app/?godmode=success
# The app appends ?client_reference_id=<account id> so the stripe-webhook Edge
# Function can grant Godmode server-side (the authoritative entitlement).
# When unset, the app falls back to a clearly-labeled DEMO unlock.
VITE_STRIPE_PAYMENT_LINK=

# Optional real backend (Supabase). Leave blank to run in local/demo mode.
# Create a project at https://supabase.com, run supabase/schema.sql, then paste
# the project URL and anon (public) key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
