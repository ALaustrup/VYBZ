# VYBZ environment variables
# Copy to `.env.local` (or run `vercel env pull .env.local` after linking the project).
# Never commit `.env.local` — it is git-ignored.

# ── Supabase (required for multi-user mode) ─────────────────────────────────
# Supabase project ref xixmneooyufbeftdfpcm (us-west-1)
# Dashboard: https://supabase.com/dashboard/project/xixmneooyufbeftdfpcm
# Vercel project: astramatrix/vybz (GitHub: ALaustrup/VYBZ → main)
VITE_SUPABASE_URL=https://xixmneooyufbeftdfpcm.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Canonical app URL (auth redirects, email links, passkeys) ───────────────
# Production canon: https://vybz.cloud — configure in Supabase Auth + Resend.
# Preview alias: https://vybz-astramatrix.vercel.app
# VITE_APP_URL=https://vybz.cloud

# ── Site visuals CDN (backdrop + VDock loops) ───────────────────────────────
# Default: public Supabase bucket `site-visuals` on the VYBZ project.
# Offline / local encodes only: VITE_SITE_VISUALS_BASE=local
# Upload (requires service_role from Dashboard → Settings → API):
#   $env:SUPABASE_SERVICE_ROLE_KEY="..."
#   npm run visuals:upload
# VITE_SITE_VISUALS_BASE=local

# ── Stripe (Lane A — tips / credit top-ups; VYBZ Connect platform) ──────────
# Business account: VYBZ (acct_1TwTEtAnnpt9OYZI) — not Astra Matrix.
# VITE_FEATURE_TIPS=on          # client flag (already on Vercel)
# Edge (supabase secrets — use scripts/provision-stripe-vybz.sh):
#   STRIPE_SECRET_KEY=sk_test_... or sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_TIP_FEE_BPS=0
# Dashboard: https://dashboard.stripe.com/acct_1TwTEtAnnpt9OYZI/apikeys
# Webhook URL: https://xixmneooyufbeftdfpcm.supabase.co/functions/v1/stripe-webhook
# Privacy/Terms for Connect: https://vybz.cloud/legal/privacy · /legal/terms
# Credit packs (starter $5/50, plus $10/120, pro $25/350) are hardcoded in
# edge function stripe-credit-topup — not client env.
# VITE_FEATURE_TIPS=on
# Edge: STRIPE_TIP_FEE_BPS=0    # optional platform fee in basis points (e.g. 500 = 5%)

# ── Feature flags (opt-in) ──────────────────────────────────────────────────
# VITE_FEATURE_TIPS=on          # Stripe Connect tips (secondary to Flair; default off)
# VITE_FEATURE_LIVE_BOOST=on    # paid live visibility — keep OFF (pay-to-win risk)
# VITE_FEATURE_OAUTH_SPOTIFY=on # unlock Spotify for Artists Connect UI
# VITE_FEATURE_REPOS=on         # Music Repos CAS VCS on Studio (default on)
# VITE_FEATURE_PRO=off          # hide Pro badge/soft limits (default on)

# ── Edge secrets (never VITE_; set via `supabase secrets set`) ──────────────
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# OAUTH_STATE_SECRET=           # optional; defaults to SPOTIFY_CLIENT_SECRET
# Managed TURN (ExpressTURN free) — set on Supabase Edge only, never in VITE_*:
# TURN_URLS=turn:free.expressturn.com:3478?transport=udp,turn:free.expressturn.com:3478?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# APP_URL=https://vybz.cloud
# Weekly digest (edge weekly-digest — Resend HTTP API, not Auth SMTP):
# RESEND_API_KEY=re_...
# RESEND_FROM=VYBZ <noreply@vybz.cloud>
# DIGEST_CRON_SECRET=           # long random; Dashboard cron header x-digest-secret
# Schedule: POST .../functions/v1/weekly-digest Mondays 15:00 UTC (or ?dry_run=1)
#
# Alpha waitlist (edge waitlist-join public; waitlist-notify admin blast):
# WAITLIST_NOTIFY_SECRET=       # or reuse DIGEST_CRON_SECRET
# POST .../functions/v1/waitlist-notify  header x-waitlist-secret (or ?dry_run=1)
# Prefer RESEND_FROM on verified vybz.cloud (see scripts/configure-vybz-cloud-email.mjs)
#
# AI Visualizer stills (edge visual-generate — fal Flux; JWT required):
# FAL_KEY=                     # https://fal.ai dashboard → API keys; never VITE_*
# Deploy: supabase functions deploy visual-generate
# Cost: 2 Vc / generate, soft cap 10/day (RPC vc_spend_visual_generate)
#
# Sample Pack Storefront (modular tool — storefront_* tables; reuse Express Connect):
# GROQ_API_KEY=                # Groq copywriting; never VITE_*
# Deploy (JWT on): storefront-pack-copy, storefront-pack-art
# Deploy (--no-verify-jwt): storefront-checkout
# Redeploy stripe-webhook after pull (kind=storefront fulfillment + Resend)
# Client: VITE_FEATURE_STOREFRONT=off to hide; default on
# Routes: /tools/packs · /pack/:slug
#
# Email domain cutover (one-shot):
#   $env:RESEND_API_KEY="re_..."
#   $env:GODADDY_API_KEY="..."; $env:GODADDY_API_SECRET="..."
#   $env:SUPABASE_ACCESS_TOKEN="sbp_..."
#   $env:APPLY_DNS="1"; $env:WAIT_VERIFY="1"
#   node scripts/configure-vybz-cloud-email.mjs

# ── Setup scripts only (never prefix with VITE_; never commit) ───────────────
# SUPABASE_ACCESS_TOKEN=sbp_...        # https://supabase.com/dashboard/account/tokens
# SUPABASE_SERVICE_ROLE_KEY=eyJ...     # Edge Functions
# SUPABASE_SECRET_KEY=sb_secret_...    # server-side only
# SUPABASE_PROJECT_REF=xixmneooyufbeftdfpcm
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_...
# SMTP_SENDER_EMAIL=noreply@vybz.cloud
# SMTP_SENDER_NAME=VYBZ
# APP_URL=https://vybz.cloud
#
# Provision Resend + GoDaddy DNS for vybz.cloud:
#   node scripts/configure-vybz-cloud-email.mjs   # with RESEND_API_KEY (+ optional GODADDY_* APPLY_DNS=1)
# ── Bunny (RETIRED — cost; do not provision) ────────────────────────────────
# Audio/CDN moved to Supabase Storage. Keep VITE_FEATURE_BUNNY_AUDIO unset/off.
# Legacy Edge `bunny-upload` / `bunny-sign` / `bunny-live` may still exist — leave dormant.
# Live voice/SFU = LiveKit (LIVEKIT_* below), not Bunny Stream.
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_RTMP_BASE=
#
# ── LiveKit + V¢ room renewals (Edge only — never VITE_) ─────────────────────
# LIVEKIT_URL=wss://….livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# VC_RENEWALS_SECRET=           # x-cron-secret for vc-room-renewals (hourly)

# ── Android Play upload (GitHub Actions secrets — never VITE_ / never commit) ─
# ANDROID_KEYSTORE_BASE64=      # base64 of upload .jks / .keystore
# ANDROID_KEYSTORE_PWD=
# KEY_ALIAS=
# KEY_ALIAS_PWD=
# Local: android/key.properties from android/key.properties.example (gitignored)
