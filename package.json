{
  "name": "vybz-app",
  "private": true,
  "version": "1.1.0",
  "vybz": {
    "release": "Beta-1A",
    "era": "beta",
    "codename": "Suite Genesis"
  },
  "type": "module",
  "description": "VYBZ — release operating system for independent music. Find Yours. Everything between finished and released.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:e2e": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:a11y": "node scripts/run-e2e.mjs e2e/smoke.spec.ts",
    "visuals:encode": "node scripts/encode-vdock-visuals.mjs",
    "visuals:upload": "node scripts/upload-site-visuals.mjs",
    "cap:sync": "cap sync",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@supabase/supabase-js": "^2.108.1",
    "@tonejs/midi": "^2.0.28",
    "framer-motion": "^11.11.17",
    "livekit-client": "^2.21.0",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.6",
    "music-metadata": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
