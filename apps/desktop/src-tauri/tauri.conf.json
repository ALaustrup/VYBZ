{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VYBZ",
  "version": "1.1.0",
  "identifier": "cloud.vybz.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web --prefix ../..",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:web --prefix ../..",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VYBZ Desktop",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co https://vybz.cloud wss://*.supabase.co https://update.vybz.cloud https://releases.vybz.cloud; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IHJlcGxhY2Ugd2l0aCB0YXVyaSBzaWduZXIgcHVia2V5Cg==",
      "endpoints": [
        "https://update.vybz.cloud/windows/stable.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
