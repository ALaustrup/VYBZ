{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "VYBZ Desktop Windows beta — core + opener + updater + multi-window",
  "windows": ["main", "waveform"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "updater:default"
  ]
}
