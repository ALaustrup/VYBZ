# Phase 19 — TestFlight upload for VYBZ iOS Alpha
default_platform(:ios)

platform :ios do
  desc "Upload latest IPA in ios/build to TestFlight"
  lane :beta do
    ipa = Dir[File.expand_path("../../build/*.ipa", __dir__)].first
    UI.user_error!("No IPA in ios/build — run CI archive first") unless ipa

    if ENV["ASC_KEY_CONTENT"] && ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: true
      )
      upload_to_testflight(api_key: api_key, ipa: ipa, skip_waiting_for_build_processing: true)
    else
      upload_to_testflight(
        ipa: ipa,
        username: ENV["APPLE_ID"],
        skip_waiting_for_build_processing: true
      )
    end
  end
end
